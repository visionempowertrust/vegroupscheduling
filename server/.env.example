# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Sarvam AI Speech-to-Text (https://docs.sarvam.ai/api-reference-docs/speech-to-text/transcribe)
SARVAM_API_KEY=your_sarvam_subscription_key
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# saarika:v2.5 or saaras:v3 - see Sarvam docs for current recommended model
SARVAM_STT_MODEL=saarika:v2.5

# SQLite database file path
DB_PATH=./data/feedback.db

# Where uploaded audio recordings are stored
UPLOAD_DIR=./uploads
